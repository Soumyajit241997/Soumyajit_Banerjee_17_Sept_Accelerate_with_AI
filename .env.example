# Anthropic Claude is preferred when set. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq is used if ANTHROPIC_API_KEY is not set (fast inference). Get a key at https://console.groq.com
GROQ_API_KEY=

# Gemini is used as a last resort if neither of the above is set.
GOOGLE_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
